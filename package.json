{
  "name": "sekai-music-server",
  "version": "2.0.0",
  "private": true,
  "description": "Servidor de música para Sekai: catálogo, lyrics, upload, auto-scrape, normalización de audio, metadatos ID3, fuzzy search y notificaciones por correo",
  "main": "server.js",
  "author": "Yyyy",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --check server.js",
    "update-ytdlp": "npx youtube-dl-exec -U"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "fluent-ffmpeg": "^2.1.3",
    "fuse.js": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^7.14.0",
    "node-id3": "^0.2.6",
    "nodemailer": "^6.9.15",
